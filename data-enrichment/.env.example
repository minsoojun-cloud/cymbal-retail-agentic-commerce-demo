# data-enrichment ローカル開発・個別上書き用環境変数テンプレート
# 通常インストールでは ../install/config.env の値が自動参照されます。
PROJECT_ID=

# BigQuery 設定（BQ_DATASET とは別名のデータセットを指定）
BQ_DATASET=cymbal
ENRICH_BQ_DATASET=cymbal_enrichment
BQ_LOCATION=asia-northeast1
BQ_SOURCE_TABLE=

# Vertex AI Gemini（ロケーション: global）
ENRICH_GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
VERTEX_LOCATION=global
THINKING_LEVEL=LOW
ENRICH_BATCH_MODEL=gemini-3.8-flash
BATCH_LOCATION=global

# 季節・シーン画像生成 & GCS バケット（未指定時は products_images_${PROJECT_ID}）
ENRICH_IMAGE_BUCKET=
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_MODEL_PRO=gemini-3-pro-image
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image
IMAGE_DEFAULT_SIZE=600
PUBLIC_BASE_URL=
UPDATE_AICS=true

# ヘッダー右上「ストアデモ（ADK）」リンク先（ONLINE_STORE_URL でも指定可）
STORE_URL=
BRAND_NAME="Cymbal Retail"

# Cloud Run
REGION=asia-northeast1
ENRICH_SERVICE=cymbal-data-enrichment
