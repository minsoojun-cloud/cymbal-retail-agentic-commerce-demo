# ==============================================================================
# Cymbal Retail エージェンティック・コマース デモ — インストール設定ファイル
# ==============================================================================
# 使い方:
#   cp install/config.example.env install/config.env
#   vi install/config.env   # PROJECT_ID をご自身の Google Cloud プロジェクト ID に設定
#   ./install/install.sh
#
# 注意: install/config.env は .gitignore 対象です。認証情報や秘密情報は記載しないでください。
# ==============================================================================

# [必須] デプロイ先の Google Cloud プロジェクト ID（課金が有効であること）
PROJECT_ID=""

# [任意] デプロイ先リージョン（Cloud Run / BigQuery / Cloud Storage 共通）
REGION="asia-northeast1"

# [任意] Vertex AI Gemini エンドポイントのロケーション（最新 Gemini 3.x 利用のため global 推奨）
GEMINI_LOCATION="global"

# [任意] Cloud Run サービス名およびランタイム サービス アカウントのプレフィックス
# 例: SERVICE_PREFIX="cymbal" の場合:
#   - cymbal-commerce-mcp     (MCP サーバー / 非公開)
#   - cymbal-adk-agent        (ADK AIコンシェルジュ / 非公開)
#   - cymbal-site-adk         (ADK オンラインストア)
#   - cymbal-store-app        (店舗ナビ お客様向けアプリ)
#   - cymbal-store-staff      (店舗ナビ スタッフ向けアプリ)
#   - cymbal-data-enrichment  (商品情報エンリッチメント スタジオ)
SERVICE_PREFIX="cymbal"

# [任意] ランタイム サービス アカウント名（省略時は ${SERVICE_PREFIX}-runtime）
RUNTIME_SA_NAME=""

# [任意] BigQuery データセット名
BQ_DATASET="cymbal"
ENRICH_BQ_DATASET="cymbal_enrichment"

# [任意] Cloud Storage バケット名（空欄の場合は PROJECT_ID から自動生成されます）
#   CATALOG_BUCKET      既定値: ${PROJECT_ID}-catalog
#   STORE_NAVI_BUCKET   既定値: ${PROJECT_ID}-store-navi
#   ENRICH_IMAGE_BUCKET 既定値: products_images_${PROJECT_ID}
CATALOG_BUCKET=""
STORE_NAVI_BUCKET=""
ENRICH_IMAGE_BUCKET=""

# [任意] Gemini モデル指定
# 空欄のままにすると、インストール時（15_models ステップ）に install/lib/probe_models.py が
# 対象プロジェクトで利用可能な最新の Gemini モデルを自動検出し、install/.state/models.env に保存します。
# 特定のモデルに固定したい場合のみ指定してください。
GEMINI_MODEL=""
AGENT_MODEL=""
ENRICH_GEMINI_MODEL=""
IMAGE_MODEL=""

# [任意] オンラインストアの音声対話機能（1: 有効 / 0: 無効）
VOICE_ENABLED="1"

# [任意] ブランド表示名（カスタマイズ用）
BRAND_NAME="Cymbal Retail"
